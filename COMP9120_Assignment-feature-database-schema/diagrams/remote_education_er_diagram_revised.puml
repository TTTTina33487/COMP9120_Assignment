@startuml
allowmixing
left to right direction
skinparam handwritten false
skinparam shadowing false
skinparam class {
  BackgroundColor #DCE8F5
  BorderColor #17365D
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #595959
}

' Revised conceptual ER model following the lecture notation:
' rectangles = entities, ovals = attributes, diamonds = relationships,
' arrows = key constraints, bold lines = total participation.

class "REGION" as region
class "SCHOOL" as school
class "COORDINATOR" as coordinator
class "STUDENT" as student
class "ELIGIBILITY_TYPE" as eligibility_type
class "ORGANISATION" as organisation
class "PROVIDER" as provider
class "FUNDER" as funder
class "RESOURCE_OFFERING" as resource_offering
class "APPLICATION" as application
class "ALLOCATION" as allocation
class "USAGE_RECORD\n<<weak entity>>" as usage_record

hide circles
hide members

' Entity attributes
usecase "<u>region_id</u>" as a_region_id
usecase "region_name" as a_region_name
usecase "remoteness_level" as a_remoteness
usecase "internet_access_level" as a_region_internet
usecase "support_priority_level" as a_support_priority

usecase "<u>school_id</u>" as a_school_id
usecase "school_name" as a_school_name
usecase "school_type" as a_school_type

usecase "<u>coordinator_id</u>" as a_coordinator_id
usecase "coordinator_name" as a_coordinator_name
usecase "role" as a_coordinator_role

usecase "<u>student_id</u>" as a_student_id
usecase "first_name" as a_first_name
usecase "last_name" as a_last_name
usecase "year_level" as a_year_level
usecase "has_device" as a_has_device
usecase "internet_access_level" as a_student_internet

usecase "<u>eligibility_type_id</u>" as a_eligibility_id
usecase "type_name" as a_eligibility_name
usecase "description" as a_eligibility_description

usecase "<u>organisation_id</u>" as a_organisation_id
usecase "organisation_name" as a_organisation_name
usecase "contact_email" as a_contact_email

usecase "<u>offering_id</u>" as a_offering_id
usecase "resource_name" as a_resource_name
usecase "resource_type" as a_resource_type
usecase "subject_area" as a_subject_area
usecase "total_quantity" as a_total_quantity
usecase "expiry_date" as a_offering_expiry

usecase "<u>application_id</u>" as a_application_id
usecase "application_date" as a_application_date
usecase "requested_quantity" as a_requested_quantity
usecase "learning_goal" as a_learning_goal
usecase "priority_level" as a_priority_level
usecase "decision_status" as a_decision_status
usecase "decision_date" as a_decision_date
usecase "decision_reason" as a_decision_reason

usecase "<u>allocation_id</u>" as a_allocation_id
usecase "allocation_date" as a_allocation_date
usecase "quantity_allocated" as a_quantity_allocated
usecase "allocation_status" as a_allocation_status

usecase "<u>record_no</u>\n(partial key)" as a_record_no
usecase "record_date" as a_record_date
usecase "usage_type" as a_usage_type
usecase "usage_status" as a_usage_status
usecase "notes" as a_usage_notes

' Relationship attributes for the Student-Eligibility Type M:N relationship
usecase "verified_date" as a_verified_date
usecase "expiry_date" as a_eligibility_expiry
usecase "verification_status" as a_verification_status

' Relationships
<> contains
<> employs
<> enrols
<> holds
<> "ISA\n{overlapping}" as organisation_isa
<> provides
<> funds
<> requires
<> submits
<> reviews
<> requests
<> results_in
<> "tracked_by\n<<identifying>>" as tracked_by

' Attribute connections
region -- a_region_id
region -- a_region_name
region -- a_remoteness
region -- a_region_internet
region -- a_support_priority

school -- a_school_id
school -- a_school_name
school -- a_school_type

coordinator -- a_coordinator_id
coordinator -- a_coordinator_name
coordinator -- a_coordinator_role

student -- a_student_id
student -- a_first_name
student -- a_last_name
student -- a_year_level
student -- a_has_device
student -- a_student_internet

eligibility_type -- a_eligibility_id
eligibility_type -- a_eligibility_name
eligibility_type -- a_eligibility_description

organisation -- a_organisation_id
organisation -- a_organisation_name
organisation -- a_contact_email

resource_offering -- a_offering_id
resource_offering -- a_resource_name
resource_offering -- a_resource_type
resource_offering -- a_subject_area
resource_offering -- a_total_quantity
resource_offering -- a_offering_expiry

application -- a_application_id
application -- a_application_date
application -- a_requested_quantity
application -- a_learning_goal
application -- a_priority_level
application -- a_decision_status
application -- a_decision_date
application -- a_decision_reason

allocation -- a_allocation_id
allocation -- a_allocation_date
allocation -- a_quantity_allocated
allocation -- a_allocation_status

usage_record -- a_record_no
usage_record -- a_record_date
usage_record -- a_usage_type
usage_record -- a_usage_status
usage_record -- a_usage_notes

holds -- a_verified_date
holds -- a_eligibility_expiry
holds -- a_verification_status

' Key constraints and participation
school -[bold]- contains
contains --> region

coordinator -[bold]- employs
employs --> school

student -[bold]- enrols
enrols --> school

' A student may hold several eligibility types; an eligibility type may be held by many students.
student -- holds
holds -- eligibility_type

' PROVIDER and FUNDER are overlapping subtypes: one organisation may be both.
organisation -- organisation_isa
organisation_isa -- provider
organisation_isa -- funder

' Each offering has exactly one provider. Funding is optional and many-to-many.
resource_offering -[bold]- provides
provides --> provider
funder -- funds
funds -- resource_offering

' An offering may require at most one eligibility type.
resource_offering -- requires
requires --> eligibility_type

application -[bold]- submits
submits --> student

' One optional reviewer because the current scope allows at most one decision.
application -- reviews
reviews --> coordinator

application -[bold]- requests
requests --> resource_offering

' Partial allocation: one application may result in many allocations.
allocation -[bold]- results_in
results_in --> application

' Usage record is a weak entity identified by its allocation and record number.
usage_record -[bold]- tracked_by
tracked_by --> allocation

legend right
|= Symbol |= Meaning |
| underlined oval | Key attribute |
| arrow to entity | At most one entity on that side |
| bold line | Total participation |
| no arrows on both sides | Many-to-many relationship |
| weak entity / identifying relationship | Existence and identification depend on owner |
endlegend
@enduml
